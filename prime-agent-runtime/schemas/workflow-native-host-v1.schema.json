  "$id": "https://prime-agent.local/schemas/workflow-native-host-v1.schema.json",
  "title": "Prime Workflow V1 ephemeral run-agent wire contract",
  "description": "Closed request/reply contract for kernel operation workflow.run_agent using protocol prime.workflow.run-agent/v1. The strict codec rejects duplicate JSON keys, invalid UTF-8, non-finite numbers, unsafe integers, malformed frames, and trailing content before schema validation. Semantic validation recomputes correlations, UTF-8 byte counts, lowercase SHA-256, exact authoritative usage, budget fields, and quiescence before reply acceptance.",
  "oneOf": [
    {
      "$ref": "#/$defs/runAgentRequest"
    },
    {
      "$ref": "#/$defs/runAgentReply"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputTokens",
        "outputTokens",
        "cacheReadTokens",
        "cacheWriteTokens",
        "totalTokens",
        "costInput",
        "costOutput",
        "costCacheRead",
        "costCacheWrite",
        "costTotal",
        "completeness",
        "finality"
      ],
      "properties": {
        "inputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cacheReadTokens": {
          "type": "integer",
