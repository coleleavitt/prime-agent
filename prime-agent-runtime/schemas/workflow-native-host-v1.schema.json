            {
              "type": "null"
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000000.0
            }
          ]
        },
        "completeness": {
          "const": "complete_host_observation"
        },
        "finality": {
          "enum": [
            "final",
            "known_prefix"
          ]
        }
      }
    },
