%% Prime Agent architecture as of merge-rust-port 6714b023f (2026-10-07).
%% Three planes: RLM execution (what runs), Continual Harness (what is learned), RAVO (how learning is gated).
%% Native crates in the RLM plane; the harness ledger and RAVO are fork feature crates wired in pa-cli.
flowchart TB
  subgraph RLM["RLM execution plane — native crates"]
    direction LR
    USER["Client<br/>pa-cli + pa-tui<br/>daemon wire, protocol 7"] --> DAEMON["Supervisor<br/>pa-daemon::supervisor<br/>routing · roster · worker lifecycle"]
    DAEMON --> AS["Session worker<br/>pa-daemon::worker + pa-core::session_engine<br/>pa-agent turn loop · SessionFeature hooks"]
    AS --> MODEL["Model call<br/>pa-ai providers<br/>anthropic: pa-anthropic-auth source + hooks"]
    AS --> KERNEL["IPython kernel (RLM)<br/>prime-agent-runtime rlm/repl.py<br/>kernel protocol 5"]
    KERNEL -->|"host_request(reason, payload)"| HOST["HostRequestHandlers<br/>bash.* pa-bash · mcp.session.* rmcp<br/>harness.* · factory.* · computer_use.*"]
    HOST --> AS
    KERNEL -->|"rlm.spawn(task)"| CHILD["Child sessions<br/>RlmSubagentHost, one worker each"]
    CHILD --> DAEMON
    SANDBOX["pa-os-sandbox (opt-in)<br/>Landlock + seccomp · Seatbelt"] -.->|"confines kernel and its children"| KERNEL
    AS --> SESS["Session JSONL<br/>~/.prime/agent/sessions<br/>pa-session-index catalog"]
    DAEMON --> VIEW["Agents view<br/>pa-tui · featureStatus.ravo line"]
  end

  subgraph HARNESS["Continual Harness plane — pa_core::refinement + pa-ledger"]
    direction LR
    HS["HarnessState (harness_state.json)<br/>memories · skills · subagent and factory specs · prompt notes<br/>ravo: RavoState · failures · trustWindows"]
    LEDGER["Failure ledger (pa-ledger)<br/>fingerprint(kind, source, class, msg) → count<br/>global by default"]
    TRIG["Refine triggers<br/>turn interval · compact · recurrence (count ≥ 2) · regression"]
    PROP["refine planner (pa_core::refinement)<br/>one model call proposes RefinementProposal edits"]
    HS --> PROP
    LEDGER --> TRIG --> PROP
  end

  subgraph RAVO["RAVO plane — pa-ravo"]
    direction LR
    FAST["fast screen<br/>structural only (ravo_fast_screen)<br/>threshold 50"]
    DEEP["deep judge<br/>one model call, score 0-100<br/>within 10 of the best"]
    OPP["opponents<br/>evidence · scope · minimality · contracts · novelty<br/>failure:&lt;fp&gt; · referee:&lt;fp&gt;"]
    REF["referee<br/>verified replay cases in kernel Python<br/>-I -B, 10 s"]
    STEP["ravo_step (reducer)<br/>missed weight ≤ epsilon 1<br/>commit → ravo_pressure doubles missed weights"]
    AUTH["authorize_assisted_ravo<br/>digest-binds proposal + baseline<br/>provisional champion, 20-turn window"]
    CTRL["run_ravo_controller<br/>inspect → plan → implement → evaluate → step → diagnose/repair<br/>stops: accepted · round_limit · repair_limit · deadline · budget · cancelled · stale_cas"]
    SVC["ravo.run · ravo.status · ravo.cancel<br/>/ravo &lt;task&gt;"]
    ARCH["RAVO archive<br/>&lt;store&gt;/ravo/archive<br/>hash-chained events.jsonl + CAS"]
    FAST --> STEP
    DEEP --> STEP
    OPP --> STEP
    REF --> STEP
    STEP --> AUTH
    SVC --> CTRL --> STEP
    CTRL --> ARCH
  end

  AS -->|"on_message_end: tool errors · tracebacks · provider errors<br/>at every assistant turn boundary"| LEDGER
  PROP -->|"proposal (RefinementGate)"| FAST
  AUTH -->|"commit: apply edits, save state, open trust window"| HS
  HS -->|"harness digest into the session context"| AS
  LEDGER -->|"recurring fingerprints become opponents"| OPP
  LEDGER -->|"recurrence inside the provisional window = measured fault<br/>→ regression repair (gated)"| TRIG
  HOST -->|"ravo.run"| SVC
  CTRL -->|"children: one JSON-only prompt each"| MODEL
  CTRL -->|"publish_feature_status → feature_status"| DAEMON

  classDef live fill:#e6f4ea,stroke:#3a8f5a,color:#173a24;
  classDef store fill:#fff7e0,stroke:#b8860b,color:#3a2e00;
  classDef opt fill:#f1f5f9,stroke:#475569,color:#0f172a,stroke-dasharray:4 3;
  class USER,AS,MODEL,KERNEL,HOST,CHILD,DAEMON,VIEW,LEDGER,TRIG,PROP,FAST,DEEP,OPP,REF,STEP,AUTH,CTRL,SVC live;
  class HS,SESS,ARCH store;
  class SANDBOX opt;
